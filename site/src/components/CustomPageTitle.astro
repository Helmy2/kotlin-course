---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import SlideLaunchBanner from './SlideLaunchBanner.astro';

const route = Astro.locals.starlightRoute;
const rawSlug = route?.id || '';
const cleanSlug = rawSlug.replace(/\.mdx?$/, '').replace(/\/$/, '');

const moduleMap: Record<string, { title: string; count: number }> = {
	'core-kotlin': { title: '01. Core Kotlin Concepts', count: 41 },
	'null-safety': { title: '02. Null Safety & Advanced Features', count: 35 },
	'jvm-coroutines': { title: '03. JVM Interoperability & Coroutines', count: 33 },
};

const currentModule = moduleMap[cleanSlug];
---

<Default {...Astro.props}><slot /></Default>

{currentModule && (
	<SlideLaunchBanner 
		title={currentModule.title} 
		slug={cleanSlug} 
		slideCount={currentModule.count} 
	/>
)}
