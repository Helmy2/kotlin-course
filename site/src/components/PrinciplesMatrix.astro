	}
	.smell-badge {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: #f87171;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		margin-bottom: 0.35rem;
	}
	.smell-desc {
		margin: 0;
		color: var(--arch-ink-secondary, #94a3b8);
		font-size: 0.82rem;
	}
