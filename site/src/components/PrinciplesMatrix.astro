		border-color: var(--arch-cyan, #38bdf8);
		color: var(--arch-cyan, #38bdf8);
		font-weight: 600;
	}
	.results-counter {
		font-family: var(--sl-font-system-mono, monospace);
		font-size: 0.8rem;
		color: var(--arch-ink-muted, #64748b);
	}
	.matrix-hint-banner {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(56, 189, 248, 0.05);
		border: 1px dashed rgba(56, 189, 248, 0.25);
		border-radius: 4px;
		padding: 0.5rem 0.85rem;
		margin-bottom: 1rem;
