		color: var(--arch-ink-secondary, #94a3b8);
	}
	.hint-icon {
		font-size: 0.95rem;
	}
	.table-frame {
		position: relative;
		border: 1px solid var(--arch-border, #1f2a3f);
		border-radius: 4px;
		background: var(--arch-surface, #111726);
		overflow-x: auto;
	}
	.arch-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.88rem;
		text-align: left;
	}
	.arch-table th {
		background: var(--arch-bg-card, #0f172a);
		padding: 0.75rem 1rem;
		font-weight: 600;
		color: var(--arch-ink-secondary, #94a3b8);
