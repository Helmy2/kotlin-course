		flex-direction: column;
		gap: 0.5rem;
	}
	.pattern-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.pattern-chip {
		font-family: var(--sl-font-system-mono, monospace);
		font-size: 0.75rem;
		color: var(--arch-cyan, #38bdf8);
		background: rgba(56, 189, 248, 0.1);
		border: 1px solid rgba(56, 189, 248, 0.25);
