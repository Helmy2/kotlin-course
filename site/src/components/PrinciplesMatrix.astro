		width: 100%;
		padding: 0.65rem 2.2rem 0.65rem 2.5rem;
		background: var(--arch-surface, #111726);
		border: 1px solid var(--arch-border, #1f2a3f);
		border-radius: 4px;
		color: var(--arch-ink-primary, #f1f5f9);
		font-size: 0.9rem;
		outline: none;
		transition: border-color 0.15s ease;
	}
	.matrix-search-box:focus {
		border-color: var(--arch-cyan, #38bdf8);
	}
	.clear-search-btn {
		position: absolute;
		right: 0.75rem;
		background: transparent;
		border: none;
		color: var(--arch-ink-muted, #64748b);
		cursor: pointer;
		font-size: 0.85rem;
		padding: 0.2rem 0.4rem;
	}
	.filter-and-stats {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.filter-group {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.filter-tab {
		background: var(--arch-surface, #111726);
		border: 1px solid var(--arch-border, #1f2a3f);
		color: var(--arch-ink-secondary, #94a3b8);
		border-radius: 3px;
		padding: 0.35rem 0.75rem;
		font-size: 0.8rem;
		font-weight: 500;
