---
import fs from 'node:fs';
import path from 'node:path';
import SlideDeck from '../../components/SlideDeck.astro';

export function getStaticPaths() {
	return [
		{
			params: { slug: 'core-kotlin' },
			props: {
				title: '01. Core Kotlin Concepts',
				file: '01. Core Kotlin Concepts.md',
				handbookSlug: 'core-kotlin',
			},
		},
		{
			params: { slug: 'null-safety' },
			props: {
				title: '02. Null Safety & Domain Modeling',
				file: '02. Null Safety and Advanced Features.md',
				handbookSlug: 'null-safety',
			},
		},
		{
			params: { slug: 'generics-delegation' },
			props: {
				title: '03. Generics, Delegation & Collections',
				file: '03. Generics Delegation and Collections.md',
				handbookSlug: 'generics-delegation',
			},
		},
		{
			params: { slug: 'jvm-interop' },
			props: {
				title: '04. Polyglot JVM Interoperability',
				file: '04. JVM Interoperability.md',
				handbookSlug: 'jvm-interop',
			},
		},
		{
			params: { slug: 'coroutines-concurrency' },
			props: {
				title: '05. Coroutines & Structured Concurrency',
				file: '05. Coroutines and Structured Concurrency.md',
				handbookSlug: 'coroutines-concurrency',
			},
		},
		{
			params: { slug: 'async-flow' },
			props: {
				title: '06. Reactive Streams with Kotlin Flow',
				file: '06. Asynchronous Streams and Kotlin Flow.md',
				handbookSlug: 'async-flow',
			},
		},
	];
}

const { title, file, handbookSlug } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const filePath = path.resolve(`../docs/${file}`);
const markdown = fs.readFileSync(filePath, 'utf-8');
const backUrl = `${baseUrl}/${handbookSlug}/`;
---

<SlideDeck title={title} markdown={markdown} backUrl={backUrl} />
